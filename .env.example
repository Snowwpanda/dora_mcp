# DORA MCP Server Configuration
# Copy this file to .env and adjust as needed

# Transport mode: 'http' (default, for Copilot Studio/REST) or 'stdio' (for Claude Desktop)
MCP_TRANSPORT=http

# HTTP Mode Configuration (only used if MCP_TRANSPORT=http)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Enable debug mode (true/false)
MCP_DEBUG=false
